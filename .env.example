# Backend-only Brevo HTTPS transactional email credentials.
# Register and verify the sender address in Brevo before sending.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CropSense

# WhatsApp Cloud API PDF reports (backend only; never use VITE_*).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Use the exact language/locale shown for the approved template in WhatsApp Manager (for example en or en_US).
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_GRAPH_API_VERSION=v26.0
# Leave blank when the template body has no placeholders; otherwise list values in template order.
# Supported values: farmer_name,report_id
WHATSAPP_TEMPLATE_BODY_FIELDS=

# MongoDB Atlas (backend only; keep this secret and never expose it as VITE_*).
MONGODB_URI=
MONGODB_DATABASE=cropsense

# Optional API settings
CROPSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CROPSENSE_ENV=development

# CropSaathi AI (backend only; never add these values to VITE_* variables)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-30b-a3b:free
# Free alternatives from other model providers. The account-wide daily quota is shared across free models.
OPENROUTER_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=CropSaathi AI
