# Backend-only Gmail SMTP credentials for the â€œEmail PDF to meâ€ report action.
# Create an App Password for this account (with 2-Step Verification enabled).
SMTP_EMAIL=cropsensevit@gmail.com
SMTP_APP_PASSWORD=
# Used by farmer-only password reset as well as report email.

# WhatsApp Cloud API report delivery (backend only; never add these to VITE_* variables).
# The report template must be approved and include a document/PDF header.
# Set to farmer_name when the approved WhatsApp template body contains {{1}} for the farmer's name.
# Add report_id only if the approved template also has a second body placeholder.

# MongoDB Atlas (backend only; keep this secret and never expose it as VITE_*).
MONGODB_URI=
MONGODB_DATABASE=cropsense

# Optional API settings
CROPSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CROPSENSE_ENV=development

# CropSaathi AI (backend only; never add these values to VITE_* variables)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-30b-a3b:free
# Free alternatives from other model providers. The account-wide daily quota is shared across free models.
OPENROUTER_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=CropSaathi AI
